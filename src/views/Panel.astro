---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { href, t, type Lang } from '../i18n';
import { site } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const page = dict.panelPage;
const screenshots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const image = (name: string) => screenshots[`../assets/screenshots/${name}.png`]?.default;
---
<Base lang={lang} title={page.title} soft>
  <PageHeader eyebrow={dict.panel.eyebrow} title={page.title} text={page.text}>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={site.panel} class="btn btn-primary" target="_blank" rel="noopener">{dict.panel.open} <Icon name="external" class="size-4" /></a>
      <a href={href(lang, '/docs/web-panel')} class="btn btn-glass"><Icon name="book" class="size-4" /> {page.setupButton}</a>
    </div>
  </PageHeader>

  <section class="mx-auto max-w-6xl space-y-24 px-5 pt-6">
    {page.shots.map((shot, index) => {
      const src = image(shot.image);
      return (
        <article class:list={['grid items-center gap-8', index % 2 === 1 ? 'lg:grid-cols-[2fr_1fr]' : 'lg:grid-cols-[1fr_2fr]']}>
          <div class:list={[{ 'lg:order-2': index % 2 === 1 }]}>
            <span class="font-mono text-sm text-sky">{String(index + 1).padStart(2, '0')}</span>
            <h2 class="mt-2 text-2xl font-extrabold text-white">{shot.title}</h2>
            <p class="mt-3 text-lg leading-relaxed text-slate-400">{shot.text}</p>
          </div>
          <div class="glass overflow-hidden rounded-2xl p-1.5">
            {src ? (
              <Image src={src} alt={shot.title} class="w-full rounded-xl" widths={[640, 1024, 1440]} sizes="(min-width: 1152px) 760px, 100vw" loading="lazy" />
            ) : (
              <div class="grid aspect-video place-items-center rounded-xl bg-night/60 text-slate-500">{shot.title}</div>
            )}
          </div>
        </article>
      );
    })}
  </section>

  <section class="mx-auto max-w-3xl px-5 pt-28 text-center">
    <h2 class="text-3xl font-extrabold text-white">{page.setupTitle}</h2>
    <p class="mt-3 text-lg text-slate-300">{page.setupText}</p>
    <a href={href(lang, '/docs/web-panel')} class="btn btn-primary mt-7">{page.setupButton} <Icon name="arrow" class="size-4" /></a>
  </section>
</Base>
