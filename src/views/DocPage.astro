---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DocsNav from '../components/DocsNav.astro';
import { href, t, type Lang } from '../i18n';
import { slugOf, type Doc } from '../lib/docs';
import { site } from '../site';

interface Props {
  lang: Lang;
  doc: Doc;
  docs: Doc[];
}
const { lang, doc, docs } = Astro.props;
const dict = t(lang);
const { Content, headings } = await render(doc);
const outline = headings.filter((heading) => heading.depth === 2);
const index = docs.indexOf(doc);
const previous = docs[index - 1];
const next = docs[index + 1];
const link = (d: Doc) => href(lang, `/docs/${slugOf(d)}`);
---
<Base lang={lang} title={doc.data.title} description={doc.data.description} soft>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 pt-10 lg:grid-cols-[14rem_1fr] xl:grid-cols-[14rem_1fr_12rem]">
    <!-- Sidebar -->
    <aside class="lg:sticky lg:top-24 lg:h-[calc(100dvh-7rem)] lg:overflow-y-auto">
      <details class="card p-4 lg:hidden">
        <summary class="cursor-pointer font-semibold text-white">{dict.docs.title}</summary>
        <nav class="mt-4"><DocsNav lang={lang} doc={doc} docs={docs} /></nav>
      </details>
      <nav class="hidden lg:block" aria-label={dict.docs.title}>
        <DocsNav lang={lang} doc={doc} docs={docs} />
      </nav>
    </aside>

    <!-- Content -->
    <article class="min-w-0">
      <span class="eyebrow">{dict.docs.groups[doc.data.group]}</span>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-white">{doc.data.title}</h1>
      <p class="mt-3 max-w-3xl text-lg text-slate-400">{doc.data.description}</p>
      <div class="prose mt-10">
        <Content />
      </div>

      <nav class="mt-16 grid gap-4 border-t border-white/10 pt-8 sm:grid-cols-2">
        {previous ? (
          <a href={link(previous)} class="card card-hover p-4">
            <span class="text-xs text-slate-500">← {dict.docs.previous}</span>
            <span class="mt-1 block font-semibold text-white">{previous.data.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a href={link(next)} class="card card-hover p-4 text-right">
            <span class="text-xs text-slate-500">{dict.docs.next} →</span>
            <span class="mt-1 block font-semibold text-white">{next.data.title}</span>
          </a>
        )}
      </nav>
      <p class="mt-8 flex items-center gap-2 text-sm text-slate-500">
        <Icon name="discord" class="size-4" />
        <a href={site.discord} target="_blank" rel="noopener" class="hover:text-white">{dict.docs.edit}</a>
      </p>
    </article>

    <!-- On this page -->
    {outline.length > 1 && (
      <aside class="hidden xl:block">
        <div class="sticky top-24">
          <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-slate-500">{dict.docs.onThisPage}</h2>
          <ul class="space-y-2 text-sm">
            {outline.map((heading) => (
              <li><a href={`#${heading.slug}`} class="text-slate-400 hover:text-white">{heading.text}</a></li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Base>
