---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { href, t, type Lang } from '../i18n';
import { release, site } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const columns = [
  {
    title: dict.footer.product,
    links: [
      { label: dict.nav.features, url: href(lang, '/#features') },
      { label: dict.nav.download, url: href(lang, '/download') },
      { label: dict.nav.panel, url: href(lang, '/panel') },
      { label: dict.nav.faq, url: href(lang, '/faq') },
    ],
  },
  {
    title: dict.footer.resources,
    links: [
      { label: dict.download.guide, url: href(lang, '/docs/installation') },
      { label: dict.apiPage.title, url: href(lang, '/api') },
      { label: dict.nav.devGuide, url: href(lang, '/docs/modules') },
      { label: 'repo.rexlcloud.de', url: site.repository, external: true },
    ],
  },
  {
    title: dict.footer.community,
    links: [
      { label: 'Discord', url: site.discord, external: true, icon: 'discord' },
      { label: site.email, url: `mailto:${site.email}`, icon: 'mail' },
      { label: 'web.rexlcloud.de', url: site.panel, external: true, icon: 'panel' },
    ],
  },
  {
    title: dict.footer.legal,
    links: [
      { label: dict.footer.imprint, url: href(lang, '/impressum') },
      { label: dict.footer.privacy, url: href(lang, '/datenschutz') },
    ],
  },
];
---
<footer class="mt-32 border-t border-white/10 bg-night-2/60">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.4fr_repeat(4,1fr)]">
    <div>
      <a href={href(lang, '/')} class="flex items-center gap-2.5 text-lg font-extrabold text-white">
        <Logo size={30} /> rexlCloud
      </a>
      <p class="mt-3 max-w-xs text-sm text-slate-400">{dict.footer.tagline}</p>
      <p class="mt-4 font-mono text-xs text-slate-500">v{release.version}</p>
    </div>
    {columns.map((column) => (
      <div>
        <h2 class="text-sm font-semibold text-white">{column.title}</h2>
        <ul class="mt-3 space-y-2">
          {column.links.map((link: { label: string; url: string; external?: boolean; icon?: string }) => (
            <li>
              <a
                href={link.url}
                class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-white"
                {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {link.icon && <Icon name={link.icon} class="size-4" />}
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-white/5">
    <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-slate-500">© {new Date().getFullYear()} rexlCloud · {dict.footer.rights}</p>
  </div>
</footer>
