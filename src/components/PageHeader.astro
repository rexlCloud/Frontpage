---
interface Props {
  title: string;
  text?: string;
  eyebrow?: string;
}
const { title, text, eyebrow } = Astro.props;
---
<header class="mx-auto max-w-6xl px-5 pb-10 pt-16 sm:pt-20">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">{title}</h1>
  {text && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-300">{text}</p>}
  <slot />
</header>
