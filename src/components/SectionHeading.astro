---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  center?: boolean;
}
const { eyebrow, title, text, center = false } = Astro.props;
---
<div class:list={['max-w-2xl', { 'mx-auto text-center': center }]}>
  <span class="eyebrow">{eyebrow}</span>
  <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h2>
  {text && <p class="mt-4 text-lg leading-relaxed text-slate-300">{text}</p>}
</div>
